# Safe development template for Arctic RSS.
# Copy this file to .env and replace every CHANGE_ME value before use.
# Never copy the production .env into a workstation or commit it.
#
# These connection URLs use Docker Compose service names. When running `npm run dev`
# directly on the host, change `postgres`, `redis`, and `redis-ephemeral` to
# `localhost`, using ports 5432, 6379, and 6380 respectively.

# PostgreSQL and Redis
POSTGRES_DB=arctic_rss
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
# Use a non-superuser account at runtime. The migration account is only passed
# to the one-shot migrate service so schema changes do not run as the app.
DATABASE_URL=postgresql://arctic_runtime:CHANGE_ME_LOCAL_RUNTIME_PASSWORD@postgres:5432/arctic_rss?schema=public
MIGRATE_DATABASE_URL=postgresql://arctic_migrate:CHANGE_ME_LOCAL_MIGRATE_PASSWORD@postgres:5432/arctic_rss?schema=public
# Redis requires a separate high-entropy password in every environment. The
# two URLs keep durable BullMQ data separate from disposable application state.
# REDIS_URL remains only as a one-instance migration fallback; set both
# workload-specific URLs before a production separation cutover.
REDIS_PASSWORD=CHANGE_ME_LOCAL_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LOCAL_REDIS_PASSWORD@redis:6379
DURABLE_REDIS_URL=redis://:CHANGE_ME_LOCAL_REDIS_PASSWORD@redis:6379
EPHEMERAL_REDIS_URL=redis://:CHANGE_ME_LOCAL_REDIS_PASSWORD@redis-ephemeral:6379
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
EPHEMERAL_REDIS_PORT=6380

# Auth and application URLs
AUTH_SECRET=CHANGE_ME_GENERATE_A_32_BYTE_SECRET
# The one canonical browser-facing origin. Production must use HTTPS.
APP_ORIGIN=http://localhost:3000
# Optional comma-separated host aliases that should redirect to APP_ORIGIN.
APP_ALLOWED_HOSTS=
# Auth.js requires this flag; host acceptance is enforced by src/proxy.ts.
AUTH_TRUST_HOST=true
# Must exactly match APP_ORIGIN in production so Auth.js cannot derive URLs
# from request headers. NEXTAUTH_URL and NEXT_PUBLIC_APP_URL are legacy-only.
AUTH_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=true
CRON_SECRET=CHANGE_ME_GENERATE_A_SEPARATE_SECRET

# Optional Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Arctic RSS <no-reply@example.com>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_SEND_TIMEOUT_MS=45000
SMTP_POOL_MAX_CONNECTIONS=2

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set true only after both Turnstile keys are configured for APP_ORIGIN's host.
# Production startup intentionally fails when this is true but either key is absent.
TURNSTILE_REQUIRED=false

# Optional Google Analytics
# Analytics is loaded only after the browser records affirmative optional consent.
# The measurement property itself must be configured with a 14-month event-data
# retention period before the launch policy can be published.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional OpenAI-powered summaries and digests. Leave AI_PROVIDER empty for the
# built-in deterministic provider used in local development.
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=
OPENAI_SUMMARY_MODEL=
AI_DIGEST_MODEL=
# Optional model override for the reader-triggered cited story comparison.
# It defaults to gpt-5.4-mini and does not change summary or digest models.
STORY_COMPARISON_MODEL=
AI_DIGEST_CONCURRENCY=2
SMART_DIGEST_CONCURRENCY=2
SMART_DIGEST_EMAIL_CONCURRENCY=2

# Background refresh tuning
# Conservative defaults for a 2-vCPU / 512 MiB worker. Increase only after
# reviewing source_refresh metrics, queue backlog, and worker memory on the VPS.
FEED_REFRESH_CONCURRENCY=3
FEED_SCHEDULER_BATCH_SIZE=50
FEED_SCHEDULER_INTERVAL_MS=60000
# Stop polling first, then allow active durable jobs this long to finish before
# the worker exits nonzero and BullMQ safely resumes them after restart.
WORKER_GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
# Keep the all-in-one worker unless a reviewed split-workers profile rollout
# is active. Compose assigns isolated modes for the opt-in services.
WORKER_MODE=all
AUTH_TOKEN_MAINTENANCE_BATCH_SIZE=100
AUTH_TOKEN_MAINTENANCE_INTERVAL_MS=900000
SECURITY_EVENT_MAINTENANCE_BATCH_SIZE=100
SECURITY_EVENT_MAINTENANCE_INTERVAL_MS=21600000
PODCAST_REFRESH_CONCURRENCY=2

# Arctic IRC stays unavailable unless the native feature is explicitly enabled.
# Keep all public/risk-bearing options false during local setup and until an
# approved private-beta rollout has been reviewed.
ARCTIC_IRC_ENABLED=false
ARCTIC_IRC_BETA_ALLOWLIST_ENABLED=false
ARCTIC_IRC_GUEST_PREVIEW_ENABLED=false
ARCTIC_IRC_ROOM_CREATION_ENABLED=false
ARCTIC_IRC_DMS_ENABLED=false
ARCTIC_IRC_BOT_ENABLED=false
ARCTIC_IRC_EXTERNAL_ENABLED=false
# External networks remain individually disabled. Do not enable a public
# network until its operator-policy and owner-only compatibility gates pass.
ARCTIC_IRC_EXTERNAL_OFTC_ENABLED=false
ARCTIC_IRC_EXTERNAL_LIBERA_ENABLED=false
# Used only to mint short-lived, single-use browser-to-gateway connection
# tokens. Generate a separate 32-byte-or-longer random value per environment.
ARCTIC_IRC_TOKEN_SECRET=CHANGE_ME_GENERATE_A_SEPARATE_32_BYTE_SECRET
ARCTIC_IRC_TOKEN_TTL_SECONDS=60
# Connected sockets are freshly authorized at this bounded interval even if a
# Redis security event was missed. Redis loss beyond the grace period makes the
# gateway exit so Compose can restart it instead of serving a degraded process.
ARCTIC_IRC_AUTHORIZATION_MAX_AGE_SECONDS=60
ARCTIC_IRC_REDIS_DEGRADED_GRACE_SECONDS=90
# WebSocket abuse limits are intentionally bounded by the gateway. Keep the
# defaults unless a reviewed capacity test and trusted client-IP verification
# justify an adjustment.
ARCTIC_IRC_MAX_SOCKETS_PER_USER=5
ARCTIC_IRC_MAX_SOCKETS_PER_IP=20
ARCTIC_IRC_MAX_ROOMS_PER_SOCKET=20
ARCTIC_IRC_MAX_EVENT_PAYLOAD_BYTES=65536
ARCTIC_IRC_MAX_MALFORMED_EVENTS=5
ARCTIC_IRC_MAX_OUTSTANDING_OPERATIONS=8
# The retention job uses safe bounded defaults (250 records, ten passes, up to
# 45 seconds, every six hours). Keep these unset unless an operator has a
# documented reason to tune it.
ARCTIC_IRC_RETENTION_BATCH_SIZE=
ARCTIC_IRC_RETENTION_INTERVAL_MS=
ARCTIC_IRC_RETENTION_MAX_BATCHES=
ARCTIC_IRC_RETENTION_MAX_RUNTIME_MS=
# Set an actual ISO publication date only at the separately authorized policy
# publication step. Do not use a placeholder value.
ARCTICIRC_POLICY_PUBLICATION_DATE=
# The chat gateway is intentionally internal-only in Docker Compose. Keep the
# container port at 3001 unless the tunnel/reverse-proxy routing is updated too.
CHAT_GATEWAY_PORT=3001

# Optional Docker Compose Cloudflare Tunnel profile. The Hetzner production
# connector is managed separately, so leave this empty unless intentionally
# changing the routing architecture.
CLOUDFLARE_TUNNEL_TOKEN=
